{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "webpages.demo.ephemeral-roles.net"
  },
  "spec": {
    "group": "demo.ephemeral-roles.net",
    "names": {
      "kind": "Webpage",
      "plural": "webpages",
      "shortNames": [
        "wp"
      ],
      "singular": "webpage"
    },
    "scope": "Namespaced",
    "versions": [
      {
        "name": "v1alpha1",
        "schema": {
          "openAPIV3Schema": {
            "description": "An HTML webpage.",
            "properties": {
              "spec": {
                "description": "A static web page served by nginx.",
                "properties": {
                  "html": {
                    "description": "The HTML document to serve as `index.html`.",
                    "maxLength": 102400,
                    "type": "string",
                    "x-kubernetes-validations": [
                      {
                        "message": "not a full HTML document",
                        "rule": "self.lowerAscii().startsWith('<!doctype html>')"
                      }
                    ]
                  },
                  "replicas": {
                    "default": 1,
                    "description": "How many nginx pods to run at the same time.",
                    "format": "int32",
                    "maximum": 10.0,
                    "minimum": 0.0,
                    "type": "integer"
                  }
                },
                "required": [
                  "html"
                ],
                "type": "object"
              },
              "status": {
                "description": "Observed state of a `Webpage`, written only by the operator.",
                "nullable": true,
                "properties": {
                  "observedGeneration": {
                    "description": "The `metadata.generation` this status was computed from.",
                    "format": "int64",
                    "nullable": true,
                    "type": "integer"
                  },
                  "readyReplicas": {
                    "description": "Ready pods, as reported by the Deployment.",
                    "format": "int32",
                    "type": "integer"
                  }
                },
                "required": [
                  "readyReplicas"
                ],
                "type": "object"
              }
            },
            "required": [
              "spec"
            ],
            "title": "Webpage",
            "type": "object"
          }
        },
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        }
      }
    ]
  }
}
